# Cordova platform builds (generated — never commit)
/platforms/

# Cordova plugins (restored via cordova prepare)
/plugins/

# Vite build output (regenerated by npm run build)
/www/

# TypeScript build output for Cloud Functions (regenerated by `npm run build` in functions/)
/functions/lib/

# Node modules
/node_modules/
/src/node_modules/
/functions/node_modules/

# Vite cache
/.vite/
/src/.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.suo
*.user

# Android signing
*.keystore
*.jks
*.p12

# iOS
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata
DerivedData/

# Env / secrets — NEVER commit API keys
.env
.env.local
.env.example
.env.production

# Firebase native config (contains API keys)
google-services.json
GoogleService-Info.plist

# Firebase service-account keys (full admin access — NEVER commit) and CLI cache
serviceAccount*.json
*-firebase-adminsdk-*.json
/.firebase/

# txt notes*.txt
*.txt

# // instruction docs
/Docs